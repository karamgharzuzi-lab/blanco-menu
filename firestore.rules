rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The menu. Anyone can READ it (customers). Only authenticated admins can write/change it.
    match /dishes/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Visit tracking — anyone can CREATE a visit log (write-only, not readable by public). Only authenticated admins can read/manage.
    match /visits/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
